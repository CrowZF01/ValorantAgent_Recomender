   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "BASE = Path(\".\")                      # folder yang berisi vct_2021 ... vct_2026\n",
    "YEARS = [2023, 2024, 2025, 2026]      # data utama proposal\n",
    "KEY = ['Tournament', 'Stage', 'Match Type', 'Match Name', 'Map', 'Team']   # 1 komposisi = 1 tim di 1 map\n",
    "\n",
    "def read(year, sub, name):\n",
    "    path = BASE / f\"vct_{year}\" / sub / name\n",
    "    return pd.read_csv(path, keep_default_na=False, na_values=[''], low_memory=False)"
   ]
